/* Global Layout */
.hud-container {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: space-between;
    padding: 20px;
    /* Use safe area padding if needed */
}

.row {
    flex-direction: row;
}

.row-space-between {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.column {
    flex-direction: column;
}

.column-align-center {
    flex-direction: column;
    align-items: center;
}

.column-reverse {
    flex-direction: column-reverse;
}

.align-bottom {
    align-items: flex-end;
}

.hud-top-section {
    width: 100%;
    align-items: flex-start;
}

.hud-bottom-section {
    width: 100%;
    /* Empty right placeholder uses flex to keep center centered */
}

/* Base Panel Style */
.radar-panel, .team-panel {
    background-color: rgba(30, 30, 40, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(220, 180, 100, 0.6); /* Gold tint */
    padding: 10px;
}

/* Radar Top Left */
.radar-panel {
    align-items: center;
}

.minimap-container {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    overflow: hidden;
    margin-right: 15px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.4);
}

.minimap-render {
    width: 100%;
    height: 100%;
    background-color: #111;
}

.radar-overlay-icon {
    position: absolute;
    width: 16px;
    height: 16px;
    background-color: #ffaa00; /* Placeholder for player arrow */
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 8px;
}

.radar-info-column {
    width: 180px;
}

.radar-text-accent {
    color: #ffaa55;
    font-size: 14px;
    -unity-font-style: bold;
}

.radar-text-normal {
    color: #cccccc;
    font-size: 14px;
    -unity-font-style: bold;
}

.radar-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-top: 8px;
    margin-bottom: 8px;
    width: 100%;
}

.radar-progress-bg {
    height: 6px;
    background-color: #333;
    border-radius: 3px;
    margin-top: 5px;
    overflow: hidden;
}

.radar-progress-fill {
    width: 50%;
    height: 100%;
    background-color: #ff6666;
}

/* Killfeed Top Right */
.killfeed-container {
    width: 300px;
    /* Elements added dynamically */
}

.killfeed-item {
    flex-direction: row;
    background-color: rgba(40, 40, 50, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 100, 100, 0.5);
    padding: 6px 12px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: flex-end;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.killfeed-text {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
}

.killfeed-text-killer {
    color: #cccccc;
}

.killfeed-icon {
    width: 16px;
    height: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: #ff5555; /* Generic sword icon placeholder */
    border-radius: 2px;
}

/* Team UI Bottom Left */
.team-panel {
    width: 200px;
    margin-bottom: 20px;
}

.team-member {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.team-member-name {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
}

.team-member-hp-text {
    color: #44ff44;
    font-size: 11px;
}

.team-member-hp-bg {
    width: 100%;
    height: 4px;
    background-color: #333;
    border-radius: 2px;
    margin-top: 2px;
    margin-bottom: 8px;
}

.team-member-hp-fill {
    height: 100%;
    background-color: #44ff44;
    width: 100%;
}

/* Player Status Bottom Center */
.player-status-column {
    width: 400px;
}

.ability-wrapper {
    margin-bottom: 10px;
}

.spells-row {
    margin-bottom: 10px;
}

.status-icon-slot {
    width: 50px;
    height: 50px;
    background-color: rgba(20, 20, 20, 0.8);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(220, 180, 100, 0.8);
    margin-left: 5px;
    margin-right: 5px;
    align-items: center;
    justify-content: center;
}

.slot-key-floating {
    position: absolute;
    top: -25px;
    left: 50%;
    translate: -50% 0;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 4px;
}

.slot-bg {
    position: absolute;
    width: 100%;
    height: 100%;
}

.slot-icon {
    width: 90%;
    height: 90%;
    border-radius: 4px;
}

.slot-cooldown {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 6px;
    display: none;
}

.cooldown-text {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

/* Health Bar */
.health-wrapper {
    width: 100%;
    background-color: transparent;
}

.health-label {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.health-value {
    color: #44ff44;
    font-size: 12px;
    -unity-font-style: bold;
}

.health-bar-bg-segmented {
    width: 100%;
    height: 20px;
    background-color: rgba(20, 20, 30, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(100, 100, 100, 0.5);
    margin-top: 4px;
    overflow: hidden;
}

.health-bar-fill-segmented {
    width: 100%;
    height: 100%;
    background-color: #44ffaa;
    transition-property: width;
    transition-duration: 0.2s;
}

/* Layout Utilities */
.bottom-right-placeholder {
    width: 200px; /* matches team-panel width to keep center centered */
}

/* Crosshair */
.center-crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
}

.crosshair-dot {
    width: 4px;
    height: 4px;
    background-color: white;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
}
