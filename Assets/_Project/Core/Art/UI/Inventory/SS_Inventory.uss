.inventory-root {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    display: none;
    align-items: center;
    justify-content: center;
}

.inventory-panel {
    width: 600px;
    background-color: rgba(20, 20, 25, 0.95);
    border-width: 2px;
    border-color: #555555;
    border-radius: 12px;
    padding: 30px;
    align-items: stretch;
}

.inventory-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 5px;
}

.inventory-subtitle {
    font-size: 16px;
    color: #aaaaaa;
    -unity-text-align: middle-center;
    margin-bottom: 25px;
}

.row-center {
    flex-direction: row;
    justify-content: center;
}

.inv-slot {
    width: 100px;
    height: 100px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 3px;
    border-color: #444444;
    border-radius: 10px;
    margin-left: 15px;
    margin-right: 15px;
    justify-content: center;
    align-items: center;
}

.inv-slot:hover {
    border-color: #ffffff;
    scale: 1.05;
    transition-duration: 0.1s;
}

.inv-icon {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-slot-number {
    position: absolute;
    top: -10px;
    left: -10px;
    width: 24px;
    height: 24px;
    background-color: #333333;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 12px;
    border-width: 1px;
    border-color: white;
}

.inventory-divider {
    height: 2px;
    background-color: #444444;
    margin-top: 30px;
    margin-bottom: 20px;
}

.inventory-details-container {
    background-color: rgba(0, 0, 0, 0.3);
    padding: 20px;
    border-radius: 8px;
    min-height: 150px;
}

.detail-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 5px;
}

.detail-tier {
    font-size: 16px;
    -unity-font-style: bold;
    color: #cccccc;
    margin-bottom: 15px;
}

.detail-desc {
    font-size: 16px;
    color: white;
    white-space: normal;
    margin-bottom: 15px;
}

.detail-effects {
    font-size: 14px;
    color: #bbbbbb;
    white-space: normal;
}
