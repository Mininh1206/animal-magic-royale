/* Settings Overlay */
.settings-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.settings-modal {
    width: 80%;
    max-width: 900px;
    height: 80%;
    max-height: 700px;
    background-color: #141421;
    border-radius: 20px;
    flex-direction: row;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.btn-close-settings {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    background-color: #c92a2a;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
    justify-content: center;
    align-items: center;
}

.btn-close-settings:hover {
    background-color: #f03e3e;
}

.settings-sidebar {
    width: 250px;
    background-color: #1d1d2b;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    padding: 25px 15px;
    border-right-width: 2px;
    border-right-color: #2a2a3d;
}

.settings-title {
    color: #F7B538;
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 40px;
    -unity-text-align: middle-center;
}

.settings-tab {
    background-color: transparent;
    border-width: 0;
    border-radius: 10px;
    padding: 15px 20px;
    margin-bottom: 10px;
    -unity-text-align: middle-left;
}

.settings-tab:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.settings-tab-active {
    background-color: #2a2a3d;
}

.settings-tab-text {
    color: #a0a0b0;
    font-size: 18px;
    -unity-font-style: bold;
}

.settings-tab-active .settings-tab-text {
    color: white;
}

.settings-content {
    flex-grow: 1;
    padding: 40px;
}

.settings-page {
    flex-grow: 1;
}

.settings-page-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.setting-item {
    background-color: #1d1d2b;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 15px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.setting-item-name {
    color: #F7B538;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.setting-item-desc {
    color: #a0a0b0;
    font-size: 14px;
}

.setting-dropdown {
    background-color: #efefef;
    color: #333;
    border-radius: 5px;
    padding: 10px 15px;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 0;
}

.setting-slider-track {
    width: 200px;
    height: 12px;
    background-color: #141421;
    border-radius: 6px;
    margin-right: 15px;
}

.setting-slider-fill {
    height: 100%;
    background-color: #F7B538;
    border-radius: 6px;
}

.setting-slider-value {
    color: #F7B538;
    font-size: 16px;
    -unity-font-style: bold;
    width: 40px;
}

.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 20px;
}

.btn-settings-secondary {
    background-color: #3a3a4d;
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    padding: 12px 25px;
    border-radius: 10px;
    border-width: 0;
    margin-right: 15px;
}

.btn-settings-secondary:hover {
    background-color: #4a4a5d;
}

.btn-settings-primary {
    background-color: #F7B538;
    color: #333;
    font-size: 16px;
    -unity-font-style: bold;
    padding: 12px 35px;
    border-radius: 10px;
    border-width: 0;
}

.btn-settings-primary:hover {
    background-color: #ffc966;
}
